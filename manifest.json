{
  "manifest_version": 3,
  "name": "WhatsApp Sidebar",
  "version": "5.0.0",
  "description": "Abre o WhatsApp Web dentro da barra lateral do Chrome.",
  "permissions": [
    "sidePanel",
    "tabs",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "action": {
    "default_title": "Abrir WhatsApp Sidebar",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
